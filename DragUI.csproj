<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DragUI</AssemblyName>
    <RootNamespace>DragUI</RootNamespace>
    <Version>1.1.1</Version>
    <Description>Client-side utility UI for V Rising: V Blood hunt tracker, familiar quick-summon, one-click loadouts, DPS meter, XP/hour, full character sheet, teleport tools and boss alarms.</Description>
    <BepInExPluginGuid>nezoic.DragUI</BepInExPluginGuid>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <RestoreSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreSources>

    <!-- Copy the built DLL into the r2modman profile the game is launched from:
           dotnet build -p:DeployToClient=true
         Other profile: -p:R2ModmanProfile=Name
         Any other BepInEx install: -p:ClientPluginDirectory="...\BepInEx\plugins\DragUI" -->
    <DeployToClient>false</DeployToClient>
    <R2ModmanProfile Condition="'$(R2ModmanProfile)' == ''">Default</R2ModmanProfile>
    <ClientPluginDirectory Condition="'$(ClientPluginDirectory)' == ''">$(APPDATA)\r2modmanPlus-local\VRising\profiles\$(R2ModmanProfile)\BepInEx\plugins\DragUI</ClientPluginDirectory>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\prefab-names.tsv.gz" LogicalName="DragUI.prefab-names.tsv.gz" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="[6.0.0-be.733]" IncludeAssets="compile" />
    <PackageReference Include="VampireReferenceAssemblies" Version="[1.1.12-r99041-b2]" />
  </ItemGroup>

  <Target Name="DeployToClientDir" AfterTargets="Build" Condition="'$(DeployToClient)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ClientPluginDirectory)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="DragUI -> $(ClientPluginDirectory)" />
  </Target>

</Project>
